{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovereign-tower-wiki",
  "compatibility_date": "2026-08-09",
  "routes": [
    {
      "pattern": "sovereigntower.org",
      "custom_domain": true
    },
    {
      "pattern": "www.sovereigntower.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
